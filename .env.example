# ReelForge credentials — copy to `.env` and fill in what you need.
# Everything is OPTIONAL: with nothing set, the pipeline runs offline in dry-run.
# `.env` is gitignored. Check status any time with:  reelforge setup
# --------------------------------------------------------------------------

# === bike_pov (footage) needs NOTHING to run in dry-run. ===
# For LIVE publishing of bike_pov you only need the YouTube and/or Instagram
# blocks below. The generative blocks are ONLY for nursery_rhymes / tv_series_talk.

# --- YouTube: research (optional) + publishing (for --live) ---
YOUTUBE_API_KEY=                    # Data API v3 key -> trend research
REELFORGE_YT_TOKEN_FILE=            # path to token JSON from: reelforge auth youtube ...
# (alternatively set these instead of a token file)
# REELFORGE_YT_CLIENT_ID=
# REELFORGE_YT_CLIENT_SECRET=
# REELFORGE_YT_TOKEN=
# REELFORGE_YT_REFRESH_TOKEN=

# --- Instagram (Business account) for --live publishing ---
REELFORGE_IG_USER_ID=
REELFORGE_IG_ACCESS_TOKEN=
# Instagram fetches the video from a PUBLIC url. Provide one directly...
REELFORGE_IG_MEDIA_URL=
# ...or let ReelForge upload the draft to your bucket automatically:
# REELFORGE_HOST_S3_BUCKET=
# REELFORGE_HOST_S3_REGION=
# REELFORGE_HOST_GCS_BUCKET=

# === Generative/hybrid ONLY (nursery_rhymes, tv_series_talk). bike_pov ignores these. ===
ANTHROPIC_API_KEY=                  # Claude: scripts/hooks (else deterministic fallback)
FAL_KEY=                            # fal.ai: video/image/voice/music (else dry-run media)
# REELFORGE_FAL_VIDEO_MODEL=fal-ai/veo3/fast
# REELFORGE_FAL_TTS_MODEL=fal-ai/kokoro
# REELFORGE_FAL_MUSIC_MODEL=fal-ai/stable-audio
# MINIMAX_API_KEY=                  # alt generative provider
# MINIMAX_GROUP_ID=
