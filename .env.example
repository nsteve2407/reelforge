# ReelForge credentials — copy to `.env` and fill in what you need.
# Everything is OPTIONAL: with nothing set, the pipeline runs offline in dry-run.
# `.env` is gitignored. Check status any time with:  reelforge setup
# Put values right after the `=` with NO inline comment on that line.
# --------------------------------------------------------------------------

# ===== bike_pov (footage) =====
# Runs in dry-run with NOTHING set. For --live you only need YouTube and/or
# Instagram below. The generative keys at the bottom are NOT used by bike_pov.

# --- YouTube Data API key (trend research) ---
YOUTUBE_API_KEY=

# --- YouTube upload (OAuth) ---
# Easiest: run `reelforge auth youtube --client-secrets cs.json --out yt_token.json`
# then put that file's path here:
REELFORGE_YT_TOKEN_FILE=
# (advanced: set these instead of a token file)
#REELFORGE_YT_CLIENT_ID=
#REELFORGE_YT_CLIENT_SECRET=
#REELFORGE_YT_TOKEN=
#REELFORGE_YT_REFRESH_TOKEN=

# --- Instagram (Business account) ---
REELFORGE_IG_USER_ID=
REELFORGE_IG_ACCESS_TOKEN=
# Instagram fetches the video from a PUBLIC url. Set one directly:
REELFORGE_IG_MEDIA_URL=
# ...or let ReelForge upload the draft to your bucket automatically (uncomment):
#REELFORGE_HOST_S3_BUCKET=
#REELFORGE_HOST_S3_REGION=
#REELFORGE_HOST_GCS_BUCKET=

# ===== Generative/hybrid ONLY (nursery_rhymes, tv_series_talk) =====
# bike_pov ignores everything below.
ANTHROPIC_API_KEY=
FAL_KEY=
#REELFORGE_FAL_VIDEO_MODEL=fal-ai/veo3/fast
#REELFORGE_FAL_TTS_MODEL=fal-ai/kokoro
#REELFORGE_FAL_MUSIC_MODEL=fal-ai/stable-audio
#MINIMAX_API_KEY=
#MINIMAX_GROUP_ID=
